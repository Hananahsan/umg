---
import { DOCS, GITHUB } from "../lib/links";
import InstallCommand from "./InstallCommand.astro";
---

<section
  class="relative overflow-hidden bg-white pt-16"
  aria-labelledby="hero-heading"
>
  <div
    class="container-content relative z-10 grid min-w-0 items-center gap-10 py-14 sm:gap-12 sm:py-20 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-16 lg:py-28"
  >
    <div class="min-w-0">
      <div
        class="fade-up mb-5 inline-flex max-w-full items-center gap-2 rounded-full border border-black/10 bg-black/[0.02] px-2.5 py-1 sm:mb-6 sm:px-3"
      >
        <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>
        <span class="text-[0.6875rem] font-medium leading-snug text-neutral-500 sm:text-xs"
          >MCP-first · Local-first · Open source · v0.2</span
        >
      </div>

      <h1
        id="hero-heading"
        class="fade-up fade-up-delay-1 font-display max-w-xl text-[clamp(2rem,8.5vw,4.25rem)] font-semibold leading-[1.05] tracking-[-0.035em] text-black text-balance sm:leading-[1.02]"
      >
        The memory layer for AI agents
      </h1>

      <p
        class="fade-up fade-up-delay-2 mt-5 max-w-lg text-base leading-relaxed text-neutral-500 sm:mt-6 sm:text-lg"
      >
        Persistent hierarchical memory that agents can retain, recall, and prune.
        One excellent local store. Clean MemoryStore port for later backends.
      </p>

      <div class="fade-up fade-up-delay-3 mt-7 flex flex-wrap items-center gap-3 sm:mt-9">
        <a href={DOCS} class="btn-primary">Start building</a>
        <a href={GITHUB} class="btn-ghost">View on GitHub</a>
      </div>

      <div class="fade-up fade-up-delay-3 mt-7">
        <InstallCommand command="npx -y @umg0/umg0" />
      </div>

      <p class="fade-up fade-up-delay-3 mt-6 text-sm text-neutral-400">
        Drop-in via MCP (stdio). Offline by default. No cloud required.
      </p>

      <ul
        class="fade-up fade-up-delay-3 mt-8 flex flex-wrap items-center gap-2"
        aria-label="Works with"
      >
        <li class="logo-chip pointer-events-none">
          <img src="/logos/claude.svg" alt="" width="16" height="16" class="object-contain" />
          <span>Claude Code</span>
        </li>
        <li class="logo-chip pointer-events-none">
          <img src="/logos/cursor-dark.svg" alt="" width="16" height="16" class="object-contain" />
          <span>Cursor</span>
        </li>
        <li class="logo-chip pointer-events-none">
          <img
            src="/logos/hermes-mark.png"
            alt=""
            width="16"
            height="16"
            class="rounded-sm object-cover"
          />
          <span>Hermes</span>
        </li>
        <li class="logo-chip pointer-events-none">
          <img src="/logos/cline.svg" alt="" width="16" height="16" class="object-contain" />
          <span>Cline</span>
        </li>
        <li class="logo-chip pointer-events-none">
          <img src="/logos/github-copilot.svg" alt="" width="16" height="16" class="object-contain" />
          <span>Copilot</span>
        </li>
        <li class="logo-chip pointer-events-none">
          <img src="/logos/zed.svg" alt="" width="16" height="16" class="object-contain" />
          <span>Zed</span>
        </li>
        <li class="logo-chip pointer-events-none">
          <img src="/logos/mcp-dark.svg" alt="" width="16" height="16" class="object-contain" />
          <span>Any MCP client</span>
        </li>
      </ul>
    </div>

    <!-- Light session panel (matches white page) -->
    <div
      class="fade-up fade-up-delay-2 min-w-0 overflow-hidden rounded-xl border border-black/[0.08] bg-white shadow-[0_1px_2px_rgba(0,0,0,0.04),0_8px_24px_rgba(0,0,0,0.04)]"
    >
      <div
        class="flex items-center justify-between gap-3 border-b border-black/[0.06] bg-[#fafafa] px-3 py-3 sm:px-4"
      >
        <div class="flex items-center gap-2">
          <span class="h-2.5 w-2.5 rounded-full bg-black/10"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-black/10"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-black/10"></span>
        </div>
        <span class="font-mono text-[0.6875rem] text-neutral-400"
          >agent · session</span
        >
      </div>

      <div
        class="space-y-4 p-3.5 font-mono text-[0.75rem] leading-relaxed break-words text-neutral-600 sm:p-5 sm:text-[0.8125rem]"
      >
        <div class="min-w-0">
          <p class="text-neutral-400"># Session start: restore context</p>
          <p class="mt-1">
            <span class="text-accent">→</span>
            <span class="text-black">recall</span>
            <span class="text-neutral-500">("umg0 landing page")</span>
          </p>
          <div
            class="mt-2 rounded-md border border-black/[0.06] bg-[#f7f7f7] px-3 py-2 text-neutral-600"
          >
            <p class="text-accent">semantic</p>
            <p>Prefer TypeScript strict mode</p>
            <p class="mt-2 text-accent">procedural</p>
            <p>Always dry-run prune before eviction</p>
          </div>
        </div>

        <div class="min-w-0">
          <p class="text-neutral-400"># New durable fact</p>
          <p class="mt-1">
            <span class="text-accent">→</span>
            <span class="text-black">retain</span>
            <span class="break-words text-neutral-500"
              >("Brand accent is soft violet #C4B5FD", tier:
              <span class="text-accent">"semantic"</span>)</span
            >
          </p>
          <p class="mt-1 text-neutral-400">✓ stored · importance scored</p>
        </div>

        <div class="min-w-0">
          <p class="text-neutral-400"># Session end</p>
          <p class="mt-1">
            <span class="text-accent">→</span>
            <span class="text-black">reflect</span>
            <span class="break-words text-neutral-500">("decisions + prefs from session")</span>
          </p>
          <p class="mt-1 text-neutral-400">✓ consolidated · candidates retained</p>
        </div>
      </div>

      <div
        class="grid grid-cols-3 gap-px border-t border-black/[0.06] bg-black/[0.04] text-center"
      >
        <div class="bg-[#fafafa] px-3 py-3">
          <p class="font-mono text-sm font-medium text-black">4</p>
          <p class="mt-0.5 text-[0.625rem] uppercase tracking-wider text-neutral-400">
            Tiers
          </p>
        </div>
        <div class="bg-[#fafafa] px-3 py-3">
          <p class="font-mono text-sm font-medium text-black">6</p>
          <p class="mt-0.5 text-[0.625rem] uppercase tracking-wider text-neutral-400">
            MCP tools
          </p>
        </div>
        <div class="bg-[#fafafa] px-3 py-3">
          <p class="font-mono text-sm font-medium text-accent">FTS</p>
          <p class="mt-0.5 text-[0.625rem] uppercase tracking-wider text-neutral-400">
            SQLite local
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
