---
import { DOCS, EXAMPLES, GITHUB } from "../lib/links";
import InstallCommand from "./InstallCommand.astro";

const tabs = [
  {
    id: "cli",
    label: "CLI",
    code: `# Preferred (npm package @umg0/umg0)
npx -y @umg0/umg0 retain --content "Prefer TypeScript strict mode" --tier semantic
npx -y @umg0/umg0 recall --query "TypeScript"
npx -y @umg0/umg0 stats
npx -y @umg0/umg0 prune --dry-run

# After: npm i -g @umg0/umg0
# umg0 retain --content "..." --tier semantic`,
  },
  {
    id: "mcp",
    label: "MCP config",
    code: `{
  "mcpServers": {
    "umg": {
      "command": "npx",
      "args": ["-y", "@umg0/umg0", "mcp"],
      "env": {
        "UMG_LOG_LEVEL": "info"
      }
    }
  }
}

// Same block for Claude Code, Cursor, Cline, VS Code, Zed, …
// Global install alternative: command "umg0", args ["mcp"]
// See: github.com/Hananahsan/umg/tree/main/examples`,
  },
  {
    id: "agent",
    label: "Agent pattern",
    code: `# Session start
recall(query: "project + task + entities", namespace: "project:slug")

# When you learn something durable
retain(content: "concise fact", tier: "semantic")

# Session end
reflect(text: "Decision: ...\\nPreference: ...\\nCorrection: ...")

# Periodically
prune(dry_run: true)  # then without dry_run
promote_to_skill(...) # dry_run first when unsure`,
  },
];
---

<section class="section-pad border-0 bg-white" id="code" aria-labelledby="code-heading">
  <div class="container-content">
    <div class="grid min-w-0 items-start gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-16">
      <div class="min-w-0">
        <p class="eyebrow mb-4">Quickstart</p>
        <h2
          id="code-heading"
          class="font-display text-[clamp(1.625rem,4.5vw,2.5rem)] font-semibold tracking-[-0.03em] text-black text-balance"
        >
          Memory in minutes. Not a platform migration.
        </h2>
        <p class="mt-5 text-base leading-relaxed text-neutral-500">
          Connect via MCP or use the CLI. Same six tools for retain, recall, reflect,
          list, prune, and promote in any MCP-compatible client.
        </p>
        <div class="mt-7">
          <InstallCommand command="npm i @umg0/umg0" />
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={DOCS} class="btn-primary">Read the quickstart</a>
          <a href={EXAMPLES} class="btn-ghost">Client configs</a>
          <a href={GITHUB} class="btn-ghost">GitHub</a>
        </div>
      </div>

      <div class="min-w-0 w-full">
        <div class="code-window max-w-full" data-tabs>
          <div
            class="flex items-center gap-1 overflow-x-auto border-b border-white/10 px-2 py-2 sm:px-3"
            role="tablist"
            aria-label="Code examples"
          >
            {
              tabs.map((tab, i) => (
                <button
                  type="button"
                  class="tab-btn shrink-0 !text-neutral-400 aria-selected:!bg-white/10 aria-selected:!text-white"
                  role="tab"
                  id={`tab-${tab.id}`}
                  aria-selected={i === 0 ? "true" : "false"}
                  aria-controls={`panel-${tab.id}`}
                  data-tab={tab.id}
                >
                  {tab.label}
                </button>
              ))
            }
          </div>

          {
            tabs.map((tab, i) => (
              <div
                class="tab-panel min-w-0 p-3 sm:p-5"
                role="tabpanel"
                id={`panel-${tab.id}`}
                aria-labelledby={`tab-${tab.id}`}
                hidden={i !== 0}
                data-panel={tab.id}
              >
                <pre class="code-scroll max-w-full overflow-x-auto font-mono text-[0.75rem] leading-relaxed text-neutral-300 sm:text-[0.8125rem]"><code>{tab.code}</code></pre>
              </div>
            ))
          }
        </div>
        <p class="mt-4 text-sm leading-relaxed text-neutral-500">
          Same MCP server works across clients. Only the config file location changes.
        </p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.querySelectorAll("[data-tabs]").forEach((root) => {
    const tabs = root.querySelectorAll("[data-tab]");
    const panels = root.querySelectorAll("[data-panel]");
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const id = tab.getAttribute("data-tab");
        tabs.forEach((t) =>
          t.setAttribute("aria-selected", t === tab ? "true" : "false"),
        );
        panels.forEach((p) => {
          p.hidden = p.getAttribute("data-panel") !== id;
        });
      });
    });
  });
</script>
