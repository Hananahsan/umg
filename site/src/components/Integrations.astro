---
const tools: Array<{
  name: string;
  logo: string;
  href?: string;
}> = [
  {
    name: "Claude Code",
    logo: "/logos/claude.svg",
    href: "https://docs.anthropic.com/en/docs/claude-code",
  },
  {
    name: "Cursor",
    logo: "/logos/cursor-dark.svg",
    href: "https://cursor.com",
  },
  {
    name: "Hermes",
    logo: "/logos/hermes-mark.png",
    href: "https://hermes-agent.nousresearch.com",
  },
  {
    name: "Cline / Roo",
    logo: "/logos/cline.svg",
  },
  {
    name: "VS Code Copilot",
    logo: "/logos/github-copilot.svg",
    href: "https://code.visualstudio.com",
  },
  {
    name: "Zed",
    logo: "/logos/zed.svg",
    href: "https://zed.dev",
  },
  {
    name: "Any MCP client",
    logo: "/logos/mcp-dark.svg",
    href: "https://modelcontextprotocol.io",
  },
];
---

<section class="border-y border-black/[0.06] bg-white" aria-label="Integrations">
  <div class="container-content py-10 sm:py-12 md:py-14">
    <p class="text-center text-sm text-neutral-400 text-balance">
      MCP-first — one memory layer across your tools
    </p>
    <p class="mx-auto mt-2 max-w-md text-center text-xs leading-relaxed text-neutral-400 text-balance sm:max-w-none">
      Works with Claude Code, Cursor, Hermes, Cline, VS Code, Zed, Windsurf, and any MCP client
    </p>
    <ul class="mt-6 flex flex-wrap items-center justify-center gap-2 sm:mt-7 sm:gap-3 md:gap-4">
      {
        tools.map((tool) => (
          <li>
            {tool.href ? (
              <a
                href={tool.href}
                class="logo-chip"
                target="_blank"
                rel="noopener noreferrer"
              >
                <img
                  src={tool.logo}
                  alt=""
                  width="18"
                  height="18"
                  class:list={[
                    "h-[18px] w-[18px]",
                    tool.name === "Hermes" ? "rounded-sm object-cover" : "object-contain",
                  ]}
                />
                <span>{tool.name}</span>
              </a>
            ) : (
              <span class="logo-chip pointer-events-none">
                <img
                  src={tool.logo}
                  alt=""
                  width="18"
                  height="18"
                  class:list={[
                    "h-[18px] w-[18px]",
                    tool.name === "Hermes" ? "rounded-sm object-cover" : "object-contain",
                  ]}
                />
                <span>{tool.name}</span>
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
