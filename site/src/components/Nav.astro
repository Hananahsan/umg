---
import { DOCS, GITHUB } from "../lib/links";
---

<header
  class="fixed inset-x-0 top-0 z-40 border-b border-black/[0.06] bg-white/85 backdrop-blur-md"
>
  <nav
    class="container-content flex h-16 items-center justify-between gap-4"
    aria-label="Primary"
  >
    <div class="flex items-center gap-8">
      <a
        href="/"
        class="flex items-center gap-2.5 text-black no-underline"
        aria-label="Nura home"
      >
        <span class="flex h-3.5 w-2.5 flex-col justify-between" aria-hidden="true">
          <span class="h-px w-full bg-accent"></span>
          <span class="h-px w-full bg-accent/80"></span>
          <span class="h-px w-full bg-accent/55"></span>
          <span class="h-px w-full bg-accent/30"></span>
        </span>
        <span class="font-display text-[0.95rem] font-semibold tracking-tight"
          >Nura</span
        >
      </a>

      <div class="hidden items-center gap-1 md:flex">
        <a
          href="#product"
          class="rounded-md px-3 py-2 text-sm text-neutral-500 transition-colors hover:text-black"
          >Product</a
        >
        <a
          href="#how"
          class="rounded-md px-3 py-2 text-sm text-neutral-500 transition-colors hover:text-black"
          >How it works</a
        >
        <a
          href="#code"
          class="rounded-md px-3 py-2 text-sm text-neutral-500 transition-colors hover:text-black"
          >Quickstart</a
        >
        <a
          href={DOCS}
          class="rounded-md px-3 py-2 text-sm text-neutral-500 transition-colors hover:text-black"
          >Docs</a
        >
      </div>
    </div>

    <div class="flex items-center gap-2">
      <a
        href={GITHUB}
        class="hidden items-center gap-2 rounded-md border border-black/10 px-3 py-1.5 text-sm text-neutral-600 transition-colors hover:border-black/20 hover:text-black sm:inline-flex"
      >
        <img
          src="/logos/github-dark.svg"
          alt=""
          class="h-4 w-4"
          width="16"
          height="16"
        />
        <span>GitHub</span>
      </a>
      <a href={DOCS} class="btn-primary">Get Started</a>
    </div>
  </nav>
</header>
