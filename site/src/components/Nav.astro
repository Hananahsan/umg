---
import { DOCS, GITHUB } from "../lib/links";
---

<header
  class="fixed inset-x-0 top-0 z-40 border-b border-border/80 bg-bg/80 backdrop-blur-md"
>
  <nav
    class="container-content flex h-16 items-center justify-between gap-4"
    aria-label="Primary"
  >
    <div class="flex items-center gap-8">
      <a
        href="/"
        class="flex items-center gap-2.5 text-text no-underline"
        aria-label="Nura home"
      >
        <span class="flex h-3.5 w-2.5 flex-col justify-between" aria-hidden="true">
          <span class="h-px w-full bg-accent"></span>
          <span class="h-px w-full bg-accent/70"></span>
          <span class="h-px w-full bg-accent/45"></span>
          <span class="h-px w-full bg-accent/25"></span>
        </span>
        <span class="font-display text-[0.95rem] font-semibold tracking-tight"
          >Nura</span
        >
      </a>

      <div class="hidden items-center gap-1 md:flex">
        <a
          href="#product"
          class="rounded-md px-3 py-2 text-sm text-text-muted transition-colors hover:text-text"
          >Product</a
        >
        <a
          href="#how"
          class="rounded-md px-3 py-2 text-sm text-text-muted transition-colors hover:text-text"
          >How it works</a
        >
        <a
          href="#code"
          class="rounded-md px-3 py-2 text-sm text-text-muted transition-colors hover:text-text"
          >Quickstart</a
        >
        <a
          href={DOCS}
          class="rounded-md px-3 py-2 text-sm text-text-muted transition-colors hover:text-text"
          >Docs</a
        >
      </div>
    </div>

    <div class="flex items-center gap-2">
      <a
        href={GITHUB}
        class="hidden items-center gap-2 rounded-md border border-border px-3 py-1.5 text-sm text-text-muted transition-colors hover:border-border-strong hover:text-text sm:inline-flex"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.387.6.113.82-.26.82-.577 0-.285-.01-1.04-.016-2.04-3.338.726-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.757-1.333-1.757-1.09-.745.083-.73.083-.73 1.205.085 1.84 1.237 1.84 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.775.418-1.305.76-1.605-2.665-.304-5.467-1.332-5.467-5.93 0-1.31.468-2.382 1.236-3.222-.124-.303-.536-1.524.117-3.176 0 0 1.008-.322 3.3 1.23a11.5 11.5 0 0 1 3.003-.404c1.02.005 2.047.138 3.003.404 2.29-1.552 3.297-1.23 3.297-1.23.655 1.652.243 2.873.12 3.176.77.84 1.235 1.912 1.235 3.222 0 4.61-2.807 5.624-5.48 5.921.43.372.814 1.103.814 2.222 0 1.606-.015 2.898-.015 3.293 0 .32.216.694.825.576C20.565 21.796 24 17.297 24 12 24 5.37 18.63 0 12 0z"
          ></path>
        </svg>
        <span>GitHub</span>
      </a>
      <a href={DOCS} class="btn-primary">Get Started</a>
    </div>
  </nav>
</header>
