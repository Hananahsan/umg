---
import { DOCS, GITHUB } from "../lib/links";
import BrandLogo from "./BrandLogo";
---

<header
  class="fixed inset-x-0 top-0 z-40 border-b border-black/[0.06] bg-white/85 backdrop-blur-md"
>
  <nav
    class="container-content flex h-16 items-center justify-between gap-4"
    aria-label="Primary"
  >
    <div class="flex items-center gap-8">
      <a
        href="/"
        class="flex items-center gap-2.5 text-black no-underline"
        aria-label="umg0 home"
      >
        <BrandLogo client:load size={20} theme="light" />
        <span class="font-display text-[0.95rem] font-semibold tracking-tight"
          >umg0</span
        >
      </a>

      <div class="hidden items-center gap-1 md:flex">
        <a
          href="#product"
          class="rounded-md px-3 py-2 text-sm text-neutral-500 transition-colors hover:text-black"
          >Product</a
        >
        <a
          href="#how"
          class="rounded-md px-3 py-2 text-sm text-neutral-500 transition-colors hover:text-black"
          >How it works</a
        >
        <a
          href="#code"
          class="rounded-md px-3 py-2 text-sm text-neutral-500 transition-colors hover:text-black"
          >Quickstart</a
        >
        <a
          href={DOCS}
          class="rounded-md px-3 py-2 text-sm text-neutral-500 transition-colors hover:text-black"
          >Docs</a
        >
      </div>
    </div>

    <div class="flex items-center gap-2">
      <a
        href={GITHUB}
        class="btn-ghost hidden !h-8 !px-3 !text-xs sm:inline-flex"
      >
        <img
          src="/logos/github-dark.svg"
          alt=""
          class="h-3.5 w-3.5"
          width="14"
          height="14"
        />
        <span>GitHub</span>
      </a>
      <a href={DOCS} class="btn-primary !h-8 !px-3.5 !text-xs">Get Started</a>
    </div>
  </nav>
</header>
