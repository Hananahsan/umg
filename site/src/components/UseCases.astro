---
const cases = [
  {
    title: "Coding agents",
    body: "MCP coding agents (Claude Code, Cursor, Cline, Hermes, and more) that recall project decisions, style prefs, and past fixes instead of relearning every session.",
  },
  {
    title: "Personal agent memory",
    body: "Preferences, constraints, and standing instructions that survive context resets across tools.",
  },
  {
    title: "Project knowledge",
    body: "Namespace-scoped facts for each codebase: architecture choices, naming rules, and hard-won lessons.",
  },
  {
    title: "Skill promotion",
    body: "Patterns that prove useful promote to procedural skills: durable playbooks, not one-off notes.",
  },
];
---

<section
  class="section-pad border-0 bg-white"
  id="use-cases"
  aria-labelledby="use-cases-heading"
>
  <div class="container-content">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4">Use cases</p>
      <h2
        id="use-cases-heading"
        class="font-display text-[clamp(1.75rem,3.5vw,2.5rem)] font-semibold tracking-[-0.03em] text-black"
      >
        Built for agents that need durable context.
      </h2>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2">
      {
        cases.map((c) => (
          <article class="panel p-7 transition-colors">
            <h3 class="font-display text-base font-semibold tracking-tight text-black">
              {c.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-neutral-500">{c.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
