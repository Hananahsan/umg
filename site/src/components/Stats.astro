---
const stats = [
  { value: "4", label: "Memory tiers", sub: "working → procedural" },
  { value: "6", label: "MCP tools", sub: "retain through promote" },
  { value: "FTS-first", label: "Default search", sub: "optional hybrid embeds" },
  { value: "7d", label: "Metrics window", sub: "stats + umg://stats" },
];
---

<section class="section-pad border-0 bg-white" aria-label="At a glance">
  <div class="container-content">
    <dl class="grid grid-cols-2 gap-x-4 gap-y-8 sm:gap-8 md:grid-cols-4 md:gap-6">
      {
        stats.map((stat) => (
          <div class="flex min-w-0 flex-col">
            <dd class="font-display text-2xl font-semibold tracking-tight text-black sm:text-3xl md:text-4xl">
              {stat.value}
            </dd>
            <dt class="mt-1.5 text-sm font-medium text-black sm:mt-2">{stat.label}</dt>
            <p class="mt-1 text-xs leading-snug text-neutral-500 sm:text-sm">{stat.sub}</p>
          </div>
        ))
      }
    </dl>
  </div>
</section>
