---
import MemoryOrb from "./MemoryOrb";

const tiers = [
  {
    name: "working",
    purpose: "Current task scratch",
    meta: "24h · cap 50",
    active: false,
  },
  {
    name: "episodic",
    purpose: "Specific interactions",
    meta: "30d · cap 500",
    active: false,
  },
  {
    name: "semantic",
    purpose: "Facts, prefs, decisions",
    meta: "365d · cap 1000",
    active: true,
  },
  {
    name: "procedural",
    purpose: "Skills & lessons",
    meta: "near-immortal · cap 200",
    active: false,
  },
];

const memories = [
  {
    tier: "semantic",
    content: "Brand accent is soft violet #C4B5FD",
    score: "0.91",
  },
  {
    tier: "semantic",
    content: "Prefer TypeScript strict mode across the monorepo",
    score: "0.87",
  },
  {
    tier: "procedural",
    content: "Always dry-run prune before destructive eviction",
    score: "0.94",
  },
  {
    tier: "episodic",
    content: "Landing page copy review: omit Login until auth exists",
    score: "0.62",
  },
];
---

<section class="section-pad border-0 bg-transparent" id="product" aria-labelledby="product-heading">
  <div class="container-content">
    <div class="grid items-start gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div>
        <p class="eyebrow mb-4">Product</p>
        <h2
          id="product-heading"
          class="font-display text-[clamp(1.75rem,3.5vw,2.5rem)] font-semibold tracking-[-0.03em] text-white text-balance"
        >
          Hierarchical memory, not a bigger bag.
        </h2>
        <p class="mt-5 text-base leading-relaxed text-neutral-400">
          Every memory has a tier, importance, decay score, and lifecycle.
          Recall re-ranks with configurable weights: FTS, importance, decay,
          tier, recency, and entity match. Then consolidation keeps the store
          sharp.
        </p>

        <ul class="mt-8 space-y-3">
          {
            [
              "Auto-tier on write, or set tier explicitly",
              "Additive-first writes; supersede only when confidence is clear",
              "Multi-pass merge and promotion quality gates",
              "Namespace isolation (optional hard isolation)",
            ].map((line) => (
              <li class="flex items-start gap-3 text-sm text-neutral-400">
                <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-accent" />
                <span>{line}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="code-window">
        <div
          class="flex items-center justify-between border-b border-white/10 px-4 py-3"
        >
          <div class="flex items-center gap-3">
            <span class="font-display text-sm font-semibold text-white">Nura</span>
            <span
              class="rounded border border-white/10 px-1.5 py-0.5 font-mono text-[0.625rem] text-neutral-500"
              >namespace · global</span
            >
          </div>
          <!-- searching orb = live recall over the memory store -->
          <div class="flex items-center gap-2">
            <MemoryOrb
              client:visible
              size={20}
              theme="dark"
              speed={0.35}
              label="Recalling from hierarchical memory"
            />
            <span class="font-mono text-[0.6875rem] text-neutral-500"
              >recall</span
            >
          </div>
        </div>

        <div class="grid border-b border-white/10 sm:grid-cols-4">
          {
            tiers.map((tier) => (
              <div
                class:list={[
                  "border-b border-white/10 px-3 py-3 sm:border-b-0 sm:border-r sm:last:border-r-0 sm:border-white/10",
                  tier.active && "bg-accent-dim/40",
                ]}
              >
                <p
                  class:list={[
                    "font-mono text-[0.6875rem]",
                    tier.active ? "text-accent" : "text-neutral-500",
                  ]}
                >
                  {tier.name}
                </p>
                <p class="mt-1 text-xs text-neutral-400">{tier.purpose}</p>
                <p class="mt-1 font-mono text-[0.625rem] text-neutral-500">
                  {tier.meta}
                </p>
              </div>
            ))
          }
        </div>

        <div class="p-2 sm:p-3">
          <div
            class="mb-2 flex items-center justify-between px-2 py-1 text-[0.625rem] uppercase tracking-wider text-neutral-500"
          >
            <span>Active memories</span>
            <span>score</span>
          </div>
          <ul class="space-y-1">
            {
              memories.map((m) => (
                <li class="flex items-start justify-between gap-3 rounded-lg px-3 py-2.5 transition-colors hover:bg-white/[0.03]">
                  <div class="min-w-0">
                    <span class="font-mono text-[0.625rem] text-accent/80">
                      {m.tier}
                    </span>
                    <p class="mt-0.5 truncate text-sm text-white">{m.content}</p>
                  </div>
                  <span class="shrink-0 font-mono text-xs text-neutral-500">
                    {m.score}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <div
          class="flex flex-wrap gap-2 border-t border-white/10 px-4 py-3 font-mono text-[0.6875rem] text-neutral-500"
        >
          <span class="rounded bg-white/[0.04] px-2 py-1">retain</span>
          <span class="rounded bg-white/[0.04] px-2 py-1">recall</span>
          <span class="rounded bg-white/[0.04] px-2 py-1">reflect</span>
          <span class="rounded bg-white/[0.04] px-2 py-1">list_memories</span>
          <span class="rounded bg-white/[0.04] px-2 py-1">prune</span>
          <span class="rounded bg-white/[0.04] px-2 py-1">promote_to_skill</span>
        </div>
      </div>
    </div>
  </div>
</section>
