---
import { DOCS, GITHUB } from "../lib/links";
import StripedText from "./StripedText.astro";
---

<section
  class="relative overflow-hidden border-0 bg-white"
  aria-labelledby="cta-heading"
>
  <div class="container-content relative z-10 py-16 text-center sm:py-24 md:py-28">
    <p class="eyebrow mb-5 sm:mb-6">Get started</p>

    <h2 id="cta-heading" class="cta-headline font-display mx-auto text-black">
      Give your agents a <StripedText text="memory" fill="#0a0a0a" /> that lasts.
    </h2>

    <p
      class="mx-auto mt-6 max-w-md px-1 text-base leading-relaxed text-neutral-500 sm:mt-8 md:text-lg"
    >
      Persistent. Hierarchical. Clean. Install locally and connect via MCP in
      minutes.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3 sm:mt-12">
      <a href={DOCS} class="btn-primary">Start building</a>
      <a href={GITHUB} class="btn-ghost">
        <span class="inline-flex items-center gap-2">
          <img
            src="/logos/github-dark.svg"
            alt=""
            class="h-4 w-4"
            width="16"
            height="16"
          />
          Star on GitHub
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .cta-headline {
    max-width: 14ch;
    font-size: clamp(1.875rem, 8vw, 4rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  @media (min-width: 480px) {
    .cta-headline {
      max-width: 18ch;
    }
  }

  @media (min-width: 768px) {
    .cta-headline {
      max-width: 22ch;
    }
  }
</style>
