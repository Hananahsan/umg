---
import { ARCHITECTURE, DOCS, EXAMPLES, GITHUB, LICENSE } from "../lib/links";
import BrandLogo from "./BrandLogo";

const year = new Date().getFullYear();

const columns = [
  {
    title: "Product",
    links: [
      { label: "Overview", href: "#product" },
      { label: "How it works", href: "#how" },
      { label: "Quickstart", href: "#code" },
      { label: "Use cases", href: "#use-cases" },
    ],
  },
  {
    title: "Developers",
    links: [
      { label: "Documentation", href: DOCS },
      { label: "Architecture", href: ARCHITECTURE },
      { label: "Examples", href: EXAMPLES },
      { label: "GitHub", href: GITHUB },
    ],
  },
  {
    title: "Open source",
    links: [
      { label: "MIT License", href: LICENSE },
      { label: "Repository", href: GITHUB },
    ],
  },
];
---

<footer class="relative overflow-hidden border-t border-black/10">
  <!-- Full-bleed landscape -->
  <div class="absolute inset-0" aria-hidden="true">
    <img
      src="/images/footer-bridge.jpg"
      alt=""
      width="1280"
      height="800"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover object-center"
    />
    <!-- Keep the arch readable: light top, stronger base for type -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/45 to-black/20"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-r from-black/50 via-transparent to-black/30"
    >
    </div>
  </div>

  <div class="container-content relative z-10 py-12 sm:py-16 md:py-20">
    <!-- Closing line sits in the sky / mist zone -->
    <p
      class="font-display max-w-xl text-[clamp(1.375rem,5.5vw,2.25rem)] font-semibold leading-snug tracking-[-0.03em] text-white text-balance"
    >
      Memory that spans sessions.
      <span class="mt-1 block font-normal text-white/70"
        >A bridge across context.</span
      >
    </p>

    <div class="mt-10 grid min-w-0 gap-10 sm:mt-14 sm:gap-12 md:grid-cols-[minmax(0,1.15fr)_minmax(0,2fr)] md:gap-16">
      <div>
        <a
          href="/"
          class="inline-flex items-center gap-2.5 text-white no-underline"
        >
          <BrandLogo client:visible size={20} theme="dark" />
          <span class="font-display text-sm font-semibold tracking-tight"
            >umg0</span
          >
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-white/65">
          The memory layer for AI agents. Persistent. Hierarchical. Clean.
        </p>

        <ul
          class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2"
          aria-label="Works with"
        >
          <li class="flex items-center gap-1.5 text-xs text-white/55">
            <img
              src="/logos/claude.svg"
              alt=""
              class="h-3.5 w-3.5"
              width="14"
              height="14"
            />
            Claude
          </li>
          <li class="flex items-center gap-1.5 text-xs text-white/55">
            <img
              src="/logos/cursor.svg"
              alt=""
              class="h-3.5 w-3.5"
              width="14"
              height="14"
            />
            Cursor
          </li>
          <li class="flex items-center gap-1.5 text-xs text-white/55">
            <img
              src="/logos/hermes-mark.png"
              alt=""
              class="h-3.5 w-3.5 rounded-sm object-cover"
              width="14"
              height="14"
            />
            Hermes
          </li>
          <li class="flex items-center gap-1.5 text-xs text-white/55">
            <img
              src="/logos/mcp.svg"
              alt=""
              class="h-3.5 w-3.5"
              width="14"
              height="14"
            />
            MCP
          </li>
          <li class="flex items-center gap-1.5 text-xs text-white/55">
            <img
              src="/logos/github.svg"
              alt=""
              class="h-3.5 w-3.5"
              width="14"
              height="14"
            />
            GitHub
          </li>
        </ul>
      </div>

      <div class="grid min-w-0 grid-cols-2 gap-6 sm:grid-cols-3 sm:gap-8">
        {
          columns.map((col) => (
            <div>
              <p class="text-xs font-medium uppercase tracking-[0.14em] text-white/45">
                {col.title}
              </p>
              <ul class="mt-4 space-y-2.5">
                {col.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-sm text-white/70 transition-colors hover:text-white"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-3 border-t border-white/15 pt-8 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-sm text-white/45">© {year} umg0. Open source under MIT.</p>
      <p class="text-sm text-white/45">
        Product brand for{" "}
        <a href={GITHUB} class="text-white/70 transition-colors hover:text-white"
          >UMG</a
        >
      </p>
    </div>
  </div>
</footer>
