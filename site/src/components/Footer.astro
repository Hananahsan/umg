---
import { ARCHITECTURE, DOCS, EXAMPLES, GITHUB, LICENSE } from "../lib/links";

const year = new Date().getFullYear();

const columns = [
  {
    title: "Product",
    links: [
      { label: "Overview", href: "#product" },
      { label: "How it works", href: "#how" },
      { label: "Quickstart", href: "#code" },
      { label: "Use cases", href: "#use-cases" },
    ],
  },
  {
    title: "Developers",
    links: [
      { label: "Documentation", href: DOCS },
      { label: "Architecture", href: ARCHITECTURE },
      { label: "Examples", href: EXAMPLES },
      { label: "GitHub", href: GITHUB },
    ],
  },
  {
    title: "Open source",
    links: [
      { label: "MIT License", href: LICENSE },
      { label: "Repository", href: GITHUB },
    ],
  },
];
---

<footer class="border-t border-border bg-bg-elevated/30">
  <div class="container-content py-14">
    <div class="grid gap-10 md:grid-cols-[1.2fr_2fr]">
      <div>
        <a href="/" class="inline-flex items-center gap-2.5 text-text no-underline">
          <span class="flex h-3.5 w-2.5 flex-col justify-between" aria-hidden="true">
            <span class="h-px w-full bg-accent"></span>
            <span class="h-px w-full bg-accent/70"></span>
            <span class="h-px w-full bg-accent/45"></span>
            <span class="h-px w-full bg-accent/25"></span>
          </span>
          <span class="font-display text-sm font-semibold tracking-tight">Nura</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-text-muted">
          The memory layer for AI agents. Persistent. Hierarchical. Clean.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        {
          columns.map((col) => (
            <div>
              <p class="text-xs font-medium uppercase tracking-[0.14em] text-text-faint">
                {col.title}
              </p>
              <ul class="mt-4 space-y-2.5">
                {col.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-sm text-text-muted transition-colors hover:text-text"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-border pt-8 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-sm text-text-faint">© {year} Nura. Open source under MIT.</p>
      <p class="text-sm text-text-faint">
        Product brand for{" "}
        <a href={GITHUB} class="text-text-muted hover:text-text">UMG</a>
      </p>
    </div>
  </div>
</footer>
