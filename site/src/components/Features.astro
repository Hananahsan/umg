---
const features = [
  {
    eyebrow: "Hierarchy",
    title: "Four tiers. Clear retention.",
    body: "Working for scratch, episodic for interactions, semantic for durable facts, procedural for skills. Each tier has its own TTL, cap, and decay half-life.",
    points: ["Auto-tier or explicit tier on write", "Tier priors in recall ranking", "Procedural protected by default"],
    visual: "hierarchy",
  },
  {
    eyebrow: "Consolidation",
    title: "Memory that stays sharp.",
    body: "Importance scoring, merge/dedup, contradiction supersede, time+access decay, and eviction under pressure. The differentiator is pruning quality — not store size.",
    points: ["Merge similar · supersede conflicts", "Decay from age and access", "Caps with score floors"],
    visual: "consolidate",
  },
  {
    eyebrow: "Interface",
    title: "MCP-first. Local-first.",
    body: "Standard tools agents already understand. SQLite + FTS5 offline by default. Optional LLM reflect behind a flag. No cloud dependency to start.",
    points: ["stdio MCP server", "CLI for retain / recall / prune", "Works with Claude Code & Cursor"],
    visual: "mcp",
  },
];
---

<section class="section-pad border-t border-border" id="features" aria-labelledby="features-heading">
  <div class="container-content">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4">Why Nura</p>
      <h2
        id="features-heading"
        class="font-display text-[clamp(1.75rem,3.5vw,2.5rem)] font-semibold tracking-[-0.03em] text-text"
      >
        Infrastructure-grade agent memory.
      </h2>
    </div>

    <div class="mt-16 space-y-20 md:space-y-28">
      {
        features.map((f, i) => (
          <div
            class:list={[
              "grid items-center gap-10 lg:grid-cols-2 lg:gap-16",
              i % 2 === 1 && "lg:[&>*:first-child]:order-2",
            ]}
          >
            <div>
              <p class="eyebrow mb-3">{f.eyebrow}</p>
              <h3 class="font-display text-2xl font-semibold tracking-tight text-text md:text-[1.75rem]">
                {f.title}
              </h3>
              <p class="mt-4 text-base leading-relaxed text-text-muted">
                {f.body}
              </p>
              <ul class="mt-6 space-y-2">
                {f.points.map((p) => (
                  <li class="flex items-center gap-2.5 text-sm text-text-muted">
                    <span class="h-px w-3 bg-accent/70" />
                    {p}
                  </li>
                ))}
              </ul>
            </div>

            <div class="panel overflow-hidden p-6 md:p-8">
              {f.visual === "hierarchy" && (
                <div class="space-y-2">
                  {[
                    { t: "procedural", w: "w-[55%]", o: "opacity-100" },
                    { t: "semantic", w: "w-[75%]", o: "opacity-90" },
                    { t: "episodic", w: "w-[90%]", o: "opacity-70" },
                    { t: "working", w: "w-full", o: "opacity-50" },
                  ].map((row) => (
                    <div class="flex items-center gap-3">
                      <span class={`font-mono text-[0.6875rem] text-text-faint w-20 ${row.o}`}>
                        {row.t}
                      </span>
                      <div class="h-8 flex-1 rounded bg-white/[0.03]">
                        <div
                          class={`h-full rounded bg-gradient-to-r from-accent/25 to-accent/5 ${row.w}`}
                        />
                      </div>
                    </div>
                  ))}
                  <p class="pt-4 font-mono text-[0.6875rem] text-text-faint">
                    retention ↑ · pressure ↓
                  </p>
                </div>
              )}

              {f.visual === "consolidate" && (
                <div class="font-mono text-[0.75rem] leading-relaxed">
                  <p class="text-text-faint">// write path</p>
                  <p class="mt-3 text-text-muted">
                    <span class="text-accent">1.</span> score importance
                  </p>
                  <p class="text-text-muted">
                    <span class="text-accent">2.</span> find similar
                  </p>
                  <p class="ml-4 text-text-faint">
                    → merge if similar ≥ 0.82
                  </p>
                  <p class="ml-4 text-text-faint">
                    → supersede on contradiction
                  </p>
                  <p class="text-text-muted">
                    <span class="text-accent">3.</span> insert + light prune
                  </p>
                  <div class="mt-6 rounded-lg border border-border bg-bg px-4 py-3">
                    <p class="text-text-faint">decay_score =</p>
                    <p class="mt-1 text-text">
                      importance × (0.65·time + 0.35·access)
                    </p>
                  </div>
                </div>
              )}

              {f.visual === "mcp" && (
                <div class="font-mono text-[0.75rem] leading-relaxed">
                  <p class="text-text-faint">// .mcp.json</p>
                  <pre class="mt-3 overflow-x-auto text-text-muted">{`{
  "mcpServers": {
    "nura": {
      "command": "node",
      "args": ["./dist/index.js", "mcp"]
    }
  }
}`}</pre>
                  <p class="mt-4 text-text-faint">
                    # or: umg mcp · umg retain · umg recall
                  </p>
                </div>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
